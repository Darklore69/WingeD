<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/pdf_container"
            android:name="com.example.pdfreader.ReaderPdfFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_folder"
                android:tint="?attr/colorOnSurfaceVariant"
                android:alpha="0.5"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No PDF open"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnOpenEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_open_button"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:elevation="2dp"
                android:text="Open a PDF"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Transparent Title at the top -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#77000000"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="PDF Reader"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:elevation="4dp"
            android:visibility="gone" />

        <!-- Highlight Color Palette -->
        <LinearLayout
            android:id="@+id/highlightPalette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="72dp"
            android:background="@drawable/bg_pill"
            android:padding="8dp"
            android:orientation="horizontal"
            android:elevation="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/colorYellow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#FFFF00"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Yellow" />

            <ImageView
                android:id="@+id/colorGreen"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#00FF00"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Green" />

            <ImageView
                android:id="@+id/colorBlue"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#00FFFF"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Blue" />

            <ImageView
                android:id="@+id/colorPink"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#FF00FF"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Pink" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#44FFFFFF" />

            <ImageView
                android:id="@+id/btnRemoveHighlightAtSelection"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:src="@drawable/ic_erase"
                android:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Remove highlight" />
        </LinearLayout>

        <!-- Floating menu at the bottom-left -->
        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/menuItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_pill"
                android:padding="4dp"
                android:layout_marginBottom="12dp"
                android:alpha="0"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnIndex"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_list"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Table of Contents" />

                <ImageView
                    android:id="@+id/btnOpen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_folder"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Open PDF" />

                <ImageView
                    android:id="@+id/btnMark"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_bookmark_outline"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Bookmark page" />

                <ImageView
                    android:id="@+id/btnGoto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_goto"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Go to bookmark" />

                <ImageView
                    android:id="@+id/btnTheme"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_theme"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Theme options" />

                <ImageView
                    android:id="@+id/btnClearHighlights"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_erase"
                    android:tint="#FF5252"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Clear Highlights"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnMenuToggle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="16dp"
                android:src="@drawable/ic_menu"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_pill"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Menu" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bookmarkCorner"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="top|start"
            android:rotation="220"
            android:src="@drawable/ic_origami_bookmark"
            android:visibility="gone"
            android:contentDescription="Bookmark" />

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:elevation="4dp"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/drawerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorPrimaryContainer"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Contents"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/btnRebuild"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="REBUILD"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <TextView
                    android:id="@+id/indexStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open a PDF to see its contents"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:alpha="0.8"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/drawerBookmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="No bookmark in this PDF yet"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:alpha="0.5" />

            <ListView
                android:id="@+id/indexList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp" />
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>